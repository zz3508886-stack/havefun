# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Office 临时文件
~$*
*.tmp

# Python 缓存（文档校验脚本运行产生）
__pycache__/
*.pyc

# 本地草稿（如不想入库的本地笔记）
local-notes/

# 网页刷题（web/）运行时数据与本机配置
web/results.json
web/config.json
web/__pycache__/

# 复习管理系统（app/）运行时数据与本机配置
app/config.json
app/data/
app/backend/.venv/
app/frontend/node_modules/
app/frontend/dist/

# dev-loop 过程记忆（context/ 入库，CURRENT 与锁文件除外）
context/CURRENT
context/**/*.bp.lock

# 构建与测试缓存
.pytest_cache/
*.tsbuildinfo
